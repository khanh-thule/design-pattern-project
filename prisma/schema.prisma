generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  pending
  paid
  delivered
  cancelled
}

model Customer {
  id     String  @id
  name   String
  orders Order[]
}

model Order {
  id         String      @id
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  status     OrderStatus
  createdAt  DateTime

  @@index([customerId, createdAt])
}
